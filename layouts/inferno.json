{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.11"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "inferno-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "block",
          "content": {
            "mod": "inferno-tree"
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "inferno-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 240
      },
      "min": 44,
      "max": 480,
      "background": {
        "image": "mods/inferno-chrome/art/sidebar.jpg",
        "fit": "cover"
      },
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "inferno-tabs"
          },
          "size": {
            "px": 58
          },
          "background": {
            "image": "mods/inferno-chrome/art/frieze.jpg",
            "fit": "cover"
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "inferno-pane"
                    },
                    "reveal": "always",
                    "height": 28,
                    "position": "top"
                  },
                  "background": {
                    "image": "mods/inferno-chrome/art/map.jpg",
                    "fit": "cover"
                  },
                  "border": {
                    "width": 1,
                    "color": "#7a5a3299"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 0,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          },
          "background": {
            "image": "mods/inferno-chrome/art/footer.jpg",
            "fit": "cover"
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "theme": "inferno",
  "ui_font": "Alegreya Sans",
  "terminal_padding": [
    14,
    12
  ],
  "terminal_opacity": 0.6,
  "divider": {
    "width": 1,
    "color": "#3a2a1a"
  },
  "floating": [
    {
      "id": "layout-sounds",
      "content": {
        "mod": "layout-sounds"
      },
      "edge": "bottom",
      "align": "end"
    }
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/inferno.png"
}
